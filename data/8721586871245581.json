        "changelog": [
            {
                "version": "0.37",
                "change_log": "Fixes to Despair the demo interactive story."
            },
            {
                "version": "0.36",
                "change_log": "Removed server functions as they were not being used and are expensive. Added anti-aliasing and fixed depth based flickering. Fixed crash for non-english users."
            },
            {
                "version": "0.35",
                "change_log": "Fixed issue with voice to text for narration. Auto narration has been removed as this caused issues when multiple text windows were open. Voice chat has been added ready for full VR multiplayer. Avatars are coming next."
            },
            {
                "version": "0.34",
                "change_log": "Added help assistant to edit mode to provide tips and tutorials.\nAdded more contextual tips.\nAdded sample gallery project."
            },
            {
                "version": "0.33",
                "change_log": "Improved start up scene. Allow portals to teleport to points of interest. Various fixes."
            },
            {
                "version": "0.32",
                "change_log": "Teleport, walk and fly are all now accessed on the locomotion control. (Hand menu / Move)\nYou can configure which locomotion modes are allowed for a location state.\nNew script command to launch / hide the locomotion control.\nSome improvements to \"point of interest\" settings and scripts. \n\n"
            },
            {
                "version": "0.31",
                "change_log": "Added  new demo project, Only Despair, a non-linear interactive story."
            },
            {
                "version": "0.28",
                "change_log": "Added AI Worlds experience to show off art and narrative generated with AI that can be experienced via our X82 metaverse."
            },
            {
                "version": "0.27",
                "change_log": "AI Santa  (see features experiences from the start location) + general bug fixes"
            },
            {
                "version": "0.24",
                "change_log": "Some fixes to multiplayer and MR demos to ensure your are asked to set up the correct scene objects."
            },
            {
                "version": "0.21",
                "change_log": "Fix missing backgrounds on Quest 3"
            }
        ],
